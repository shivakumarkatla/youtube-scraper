# Copy this file to ".env" if you want to change the defaults.
# No API keys, passwords or cookies are needed or used by this project.

# Seconds to wait for YouTube before giving up
REQUEST_TIMEOUT=10

# Optional: override the browser-like User-Agent header
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
